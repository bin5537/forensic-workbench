{
  "name": "forensic-workbench",
  "version": "0.1.0",
  "description": "디지털 포렌식 워크벤치 (Android / iOS / PC · 삭제 파일 복구 · 발자국 분석)",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5175 && cross-env NODE_ENV=development node scripts/launch.js\"",
    "vite": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node scripts/launch.js",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder"
  },
  "author": "b1n2da",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "pretendard": "^1.3.9",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0"
  },
  "build": {
    "appId": "com.b1n2da.forensicworkbench",
    "productName": "Forensic Workbench",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
